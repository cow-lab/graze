# ---------------------------------------------------------------------------
# Every variable the deployed app reads. Copy to .env for local work.
# Required ones are marked; the app starts without the optional ones and says
# so in the UI rather than failing.
# ---------------------------------------------------------------------------

# REQUIRED — Postgres, pooled connection. Used by the running app.
# Neon gives you two strings; this is the one with `-pooler` in the host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/graze?sslmode=require"

# REQUIRED — Postgres, direct connection. Used only by `prisma migrate`.
# Same string WITHOUT `-pooler`. Migrations cannot run through a transaction pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/graze?sslmode=require"

# REQUIRED — signs session cookies. Generate with: openssl rand -base64 32
# Changing it in production signs everyone out.
NEXTAUTH_SECRET="replace-me"

# REQUIRED in production — the site's own public URL, e.g. https://graze.vercel.app
# Locally this is http://localhost:3000.
NEXTAUTH_URL="http://localhost:3000"

# OPTIONAL — uploaded PDFs go to Vercel Blob when set. Without it, uploads are
# written to public/uploads, which works locally and is LOST on every deploy on a
# serverless host. Set this before letting real users upload anything.
BLOB_READ_WRITE_TOKEN=""

# OPTIONAL — live "Chew on this" generation. Without it the app runs in demo mode:
# placeholder explainers, clearly labelled as such in the UI. Costs real money per
# paper when set — see the cost notes in README.
ANTHROPIC_API_KEY=""

# REQUIRED for scheduled ingestion — Vercel Cron sends this as a bearer token to
# /api/cron/combine. Without it, scheduled runs are disabled (the endpoint returns 503) and
# The Combine only runs when an admin clicks "Run The Combine now".
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# OPTIONAL — forwards captured server/client errors to a webhook (Slack, Discord,
# anything that accepts a JSON POST). Without it errors are in-memory only and are
# lost on restart, which on a serverless host means almost immediately.
ERROR_WEBHOOK_URL=""

# OPTIONAL — journal indexing checks for the Field-Tested badge. Without these the
# badge shows Scopus and Web of Science as "not checked" rather than claiming a
# journal is absent from them.
ELSEVIER_API_KEY=""
CLARIVATE_API_KEY=""
